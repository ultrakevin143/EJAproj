# Copy to .env.local and keep the real values private.
PORT=3000
FRONTEND_URL=http://localhost:3001
NODE_ENV=development
ALLOW_IN_MEMORY_DB=false
SESSION_TTL_HOURS=12

# Run `npm run setup:demo-passwords` to set unique password hashes locally.
FITQUALITY_PASSWORD_HASH_USR_FRONTDESK_02=
FITQUALITY_PASSWORD_HASH_USR_CLINIC_02=
FITQUALITY_PASSWORD_HASH_USR_TURNSTILE_02=
FITQUALITY_PASSWORD_HASH_USR_STEWARD_02=
FITQUALITY_PASSWORD_HASH_USR_MANAGER_02=
FITQUALITY_PASSWORD_HASH_USR_ADMIN_02=

# Add DATABASE_URL to .env.local only when using a private database.
